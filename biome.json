{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/*.json", "!dist"] },
  "formatter": { "enabled": false },
  "linter": { "enabled": true, "includes": ["src/**"], "rules": { "preset": "recommended" } },
  "assist": {
    "enabled": true,
    "includes": ["src/**", "tests/**"],
    "actions": { "source": { "organizeImports": { "level": "on", "options": { "sortBareImports": false } } } }
  }
}
