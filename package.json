{
  "name": "@lst97-oss/last-cli",
  "version": "0.2.1",
  "description": "Create projects from payload-cms / tanstack-start templates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lst97-oss/last-cli.git"
  },
  "homepage": "https://github.com/lst97-oss/last-cli#readme",
  "type": "module",
  "bin": {
    "last-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "fmt:staged": "bun fmt --staged",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun check --no-script",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "test": "tsx --test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "giget": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
