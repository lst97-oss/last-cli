{
  "name": "@lst97-oss/last-cli",
  "version": "0.1.2",
  "description": "Create projects from payload-cms / tanstack-start templates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lst97-oss/last-cli.git"
  },
  "homepage": "https://github.com/lst97-oss/last-cli#readme",
  "type": "module",
  "bin": {
    "last-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bunx @biomejs/biome check .",
    "lint": "bunx @biomejs/biome lint src",
    "format": "bunx @biomejs/biome format --write .",
    "test": "tsx --test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "giget": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
